# ServiceHub Cordova — Backend Environment Variables Template
# Copy this file, rename it to .env, and fill in your actual values.
# NEVER commit .env to version control.

# ── Database ─────────────────────────────────────────────────────────────────
# Runtime application connection. For Neon, use the pooled hostname containing
# "-pooler" so normal API traffic does not exhaust direct database connections.
DATABASE_URL="postgresql://username:password@your-endpoint-pooler.neon.tech/neondb?sslmode=require"
# Prisma CLI/migration connection. Copy Neon's connection string with pooling
# disabled. Do not create this value by editing or guessing the hostname.
DIRECT_URL="postgresql://username:password@your-direct-endpoint.neon.tech/neondb?sslmode=require"

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="your_jwt_access_secret_must_be_at_least_16_characters_long"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_must_be_at_least_16_characters_long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────────────────────
PORT="3001"
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# Docker Compose host ports and browser-facing API URL. NEXT_PUBLIC_API_URL is
# embedded into the frontend image at build time.
FRONTEND_PORT="3000"
BACKEND_PORT="3001"
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# Optional one-time administrator bootstrap. Leave both unset to skip.
# Use a unique password of at least 14 characters and remove it from the
# deployment environment after the administrator has been provisioned.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""
ADMIN_BOOTSTRAP_NAME="ServiceHub Administrator"
ADMIN_BOOTSTRAP_PHONE=""
ADMIN_BOOTSTRAP_LOCATION="Cordova, Cebu"

# ── PayMongo (Test Mode) ──────────────────────────────────────────────────────
# Get these from dashboard.paymongo.com → Developers → API Keys
# Use test keys (pk_test_... / sk_test_...) during capstone
PAYMONGO_PUBLIC_KEY="pk_test_your_public_key_here"
PAYMONGO_SECRET_KEY="sk_test_your_secret_key_here"
# Signing secret shown after registering the public HTTPS webhook endpoint.
PAYMONGO_WEBHOOK_SECRET="whsk_your_webhook_signing_secret_here"
PRISMA_LOG_QUERIES="false"

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Get from aistudio.google.com
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_SUMMARY_MODEL="gemini-2.5-flash"

# ── Email SMTP (Nodemailer) ──────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_email_app_password"
EMAIL_FROM="ServiceHub <no-reply@servicehub.com>"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Must exactly match NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend environment.
# Register every frontend origin (for example http://localhost:3000) in the
# OAuth web client’s Authorized JavaScript origins in Google Cloud Console.
GOOGLE_CLIENT_ID="your_google_client_id_here"

# Cloudinary uploads. Supply either CLOUDINARY_URL or all three separate keys.
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
