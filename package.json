{
  "name": "servicehub-backend",
  "version": "1.0.0",
  "description": "Backend API for ServiceHub",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node ./dist/src/server.js",
    "prestart": "npm run db:check-client",
    "db:generate": "prisma generate",
    "db:check-client": "node scripts/assert-prisma-client.cjs",
    "security:geoip-update": "node scripts/update-security-geoip.cjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/deploy-migrations.cjs",
    "test:fresh-migrations": "tsx scripts/test-fresh-migrations.ts",
    "db:seed": "npx tsx prisma/seed.ts",
    "test:admin-contracts": "tsx --test src/schema/admin-contracts.test.ts",
    "test": "tsx --test src/schema/*.test.ts",
    "notifications:audit": "node dist/scripts/audit-notifications.js",
    "test:booking-integration": "tsx --test src/integration/booking-flows.test.ts",
    "test:provider-workload": "tsx --test src/integration/provider-wide-workload.test.ts",
    "test:high-priority-integration": "tsx --test src/integration/high-priority-case-workflows.test.ts",
    "test:phase2-integration": "tsx --test src/integration/queue-concurrency.test.ts",
    "test:phase3-integration": "tsx --test src/integration/privacy-deletion.test.ts",
    "test:account-deletion": "tsx --test src/integration/self-service-deletion.test.ts",
    "accounts:purge-deleted": "tsx scripts/purge-deleted-accounts.ts",
    "test:phase4-integration": "tsx --test src/integration/safety-admin-guards.test.ts",
    "test:phase5-integration": "tsx --test src/integration/listing-correctness.test.ts",
    "test:phase6-integration": "tsx --test src/integration/payment-webhook.test.ts",
    "test:phase7-integration": "tsx --test src/integration/authorization-lifecycle.test.ts",
    "test:phase7-load": "tsx --test src/integration/communication-concurrency.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "geoip-lite": "1.4.10",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "10.1.4",
    "pg": "^8.21.0",
    "socket.io": "^4.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.2",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "prisma": "7.10.0",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.0": true,
    "prisma@7.10.0": true
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "ip-address": "10.7.4",
    "socket.io-parser": "4.2.7",
    "fast-uri": "3.1.9",
    "body-parser": "2.4.0",
    "deepmerge-ts": "8.0.2",
    "esbuild": "0.28.2",
    "mysql2": "3.24.3",
    "qs": "6.16.1"
  }
}
